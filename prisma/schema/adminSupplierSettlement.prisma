// Immutable remittance entries from EPP-admin to supplier.
// Each payment/remittance creates one row for SOA traceability (like AdminFinancierSettlement).
model AdminSupplierSettlement {
  id                  String  @id @default(auto()) @map("_id") @db.ObjectId
  organizationId      String? @db.ObjectId
  supplierSettlementId String  @db.ObjectId
  supplierId          String  @db.ObjectId

  amount      Float
  currency    String   @default("PHP")
  remittedAt  DateTime?
  dueAt       DateTime?
  referenceNo String?

  // Receipt per remittance (OR or bank receipt proof)
  receiptType          ReceiptType?
  receiptNumber        String?
  receiptAttachmentUrl String?

  createdBy String?  @db.ObjectId
  notes     String?
  metadata  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supplierSettlement SupplierSettlement @relation(fields: [supplierSettlementId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([supplierSettlementId])
  @@index([supplierId])
  @@index([createdAt])
  @@map("adminSupplierSettlements")
}
