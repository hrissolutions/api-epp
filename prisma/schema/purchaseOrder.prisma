// Admin's order/request to Supplier. Created when Admin approves a client Order.
// Flow: Client Order → Admin approves → Admin creates PO to Supplier (for that order's items) → Supplier DO → Admin DR → Admin DO → Client DR.
// No bulk: each client order, when approved, triggers Admin to order those items from the Supplier.

model PurchaseOrder {
  id             String  @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String? @db.ObjectId

  poNumber String @unique // Admin's PO number (e.g. PO-2025-001)
  orderId  String @db.ObjectId // Client order that was approved; we request/order these items from supplier
  supplierId String @db.ObjectId

  status PurchaseOrderStatus @default(PENDING)

  // Items requested from supplier (from approved order's orderItems, or derived)
  items Json? // e.g. [{ itemId, sku, description, quantity, unitPrice }]

  // Supplier fulfillment info (optional)
  leadTime     Int?      // e.g. number of days
  availability String?   // e.g. IN_STOCK, BACKORDER, PREORDER (free-form)
  delivery     DateTime? // expected delivery date/time
  pdc          DateTime? // Post-Dated Check date (if applicable)

  approvedBy       String?   @db.ObjectId // Admin who approved the client order (or who created PO)
  approvedAt       DateTime? // When client order was approved
  sentToSupplierAt DateTime? // When PO was sent to supplier

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order             Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplier          Supplier           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  deliveryDocuments DeliveryDocument[] // Supplier DO(s) and Admin DR for this PO

  @@index([organizationId])
  @@index([orderId])
  @@index([supplierId])
  @@index([status])
  @@index([createdAt])
  @@map("purchaseOrders")
}

enum PurchaseOrderStatus {
  PENDING // Created, not yet approved
  APPROVED // Admin approved PO (sent to supplier)
  CONFIRMED // Supplier confirmed; Supplier DO is auto-created
  SENT // Sent to supplier (optional)
  SHIPPED // Supplier shipped
  RECEIVED // Admin received (Admin DR signed)
  CANCELLED
}
